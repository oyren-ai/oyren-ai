{
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": ["deno.ns", "deno.window"]
  },
  "imports": {
    "@/": "./src/",
    "@langchain/ollama": "npm:@langchain/ollama@^0.1.3",
    "@langchain/google-genai": "npm:@langchain/google-genai@^0.1.3",
    "@langchain/openai": "npm:@langchain/openai@^0.3.14",
    "@langchain/core": "npm:@langchain/core@^0.3.27",
    "zod": "npm:zod@^3.22.4",
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "test": {
    "include": ["**/*_test.ts", "**/*.test.ts"],
    "exclude": ["node_modules/", "src/types/"]
  },
  "coverage": {
    "exclude": ["src/types/", "node_modules/", "**/*_test.ts", "**/*.test.ts"]
  }
}
