{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "opener:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file",
    "fs:allow-exists",
    "fs:allow-create",
    "fs:allow-mkdir",
    "fs:allow-appdata-read",
    "fs:allow-appdata-write",
    "fs:allow-appdata-meta",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "shell:allow-execute",
    "shell:allow-spawn",
    "deep-link:default",
    "updater:default",
    "process:allow-restart",
    "clipboard-manager:allow-write-text",

    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "args": true,
          "name": "binaries/slidev-sidecar-x86_64-unknown-linux-gnu",
          "sidecar": true
        },
        {
          "args": true,
          "name": "oyren-ai-agent-sidecar",
          "sidecar": true
        }
      ]
    }
  ]
}
