{
  "name": "@oyren/desktop",
  "private": true,
  "version": "0.0.7",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-latex-keep.js",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:oyren-ai-agent-sidecar": "cd sidecars/ai-agent-sidecar && node build.js",
    "tauri": "tauri",
    "tauri:dev": "bash scripts/dev-with-sidecar.sh",
    "tauri:dev:devtools": "bash scripts/dev-with-sidecar.sh --features devtools",
    "tauri:build": "tauri build && node scripts/copy-sidecar-to-release.js",
    "tauri:build:debug": "tauri build --debug",
    "build:interactive": "bash scripts/interactive-build.sh",
    "test": "./scripts/run-tests-summary.sh",
    "test:coverage": "./scripts/run-tests-coverage.sh",
    "test:all": "./scripts/run-all-tests.sh",
    "test:js": "vitest run",
    "test:js:coverage": "vitest run --coverage",
    "test:rust": "cd src-tauri && cargo test --verbose",
    "test:rust:coverage": "bash ./scripts/format-rust-coverage.sh",
    "test:rust:coverage:html": "cd src-tauri && cargo llvm-cov --html --exclude-from-report '*_test.rs' --exclude-from-report '*_tests.rs' --exclude-from-report '*/tests/*' --exclude-from-report '*/test/*'",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run src/__tests__ --exclude='**/*.integration.test.{ts,tsx}'",
    "test:integration": "vitest run src/__tests__/*.integration.test.{ts,tsx}",
    "test:ci": "vitest run --config vitest.config.ci.ts --coverage",
    "typescript:check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test:e2e": "node node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.14",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-hook/throttle": "^2.2.0",
    "@react-pdf-viewer/bookmark": "^3.12.0",
    "@react-pdf-viewer/core": "^3.12.0",
    "@react-pdf-viewer/default-layout": "^3.12.0",
    "@react-pdf-viewer/get-file": "^3.12.0",
    "@react-pdf-viewer/highlight": "^3.12.0",
    "@react-pdf-viewer/page-navigation": "^3.12.0",
    "@react-pdf-viewer/rotate": "^3.12.0",
    "@react-pdf-viewer/scroll-mode": "^3.12.0",
    "@react-pdf-viewer/search": "^3.12.0",
    "@react-pdf-viewer/selection-mode": "^3.12.0",
    "@react-pdf-viewer/toolbar": "^3.12.0",
    "@react-pdf-viewer/zoom": "^3.12.0",
    "@tauri-apps/api": "^2.6.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-deep-link": "^2.4.5",
    "@tauri-apps/plugin-dialog": "^2.3.0",
    "@tauri-apps/plugin-fs": "^2.4.1",
    "@tauri-apps/plugin-opener": "^2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "latex.js": "^0.12.6",
    "lucide-react": "^0.525.0",
    "monaco-editor": "^0.54.0",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.6",
    "react-syntax-highlighter": "^15.6.1",
    "rehype-mathjax": "^7.1.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "use-debounce": "^10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.6",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "c8": "^10.1.3",
    "jest-environment-jsdom": "^30.0.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.4"
  }
}